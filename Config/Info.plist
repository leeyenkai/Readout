<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The keys here are the two Xcode's Info.plist generator cannot produce: there is no
	     INFOPLIST_KEY_ build setting for UIBackgroundModes, nor for a launch screen colour.
	     Everything else still comes from the INFOPLIST_KEY_* settings in the project and is
	     merged on top of this file.

	     `location` is what lets a recording of a journey carry on once Readout is no longer
	     in front (R-82). It is the only background mode Readout declares: the microphone and
	     the camera deliberately have none, so neither can ever run unattended. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<!-- A black launch screen, matching the app's default true-black look whatever the phone's
	     own appearance is. The generated one is the system background, which flashed white
	     before the first frame on a phone in Light mode. Generation is off in the project so
	     this dictionary is the one that ships. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
